# ---------------------------------------------------------------------------
# Trip Service — переменные окружения.
# Имена зафиксированы курсом: переименовывать нельзя, добавлять свои — можно.
# Рядом с каждым блоком указано, в какой лабораторной он становится нужен.
# ---------------------------------------------------------------------------
# --- ЛР1: сервер и база ----------------------------------------------------
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://tripgo:tripgo@localhost:5432/tripgo?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_QUERY_TIMEOUT=3s
# --- ЛР2: телеметрия -------------------------------------------------------
OTEL_SERVICE_NAME=trip-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tripgo,deployment.environment=local
OTEL_TRACES_SAMPLER=parentbased_always_on
# --- ЛР3: опрос устаревших поездок -----------------------------------------
POSITION_CHECK_INTERVAL=30s
POSITION_STALE_AFTER=60s
POSITION_WORKERS=4
POSITION_QUEUE_SIZE=100
PUSH_HTTP_URL=http://localhost:8090
PUSH_ADMIN_URL=http://localhost:8091
PUSH_REQUEST_TIMEOUT=1s
# --- ЛР4: gRPC и брокер ----------------------------------------------------
GRPC_ADDR=:9091
PUSH_GRPC_ADDR=localhost:9095
BROKER_BROKERS=localhost:19092
TRIP_EVENTS_TOPIC=trip.events.v1
TRIP_COMMANDS_TOPIC=trip.commands.v1
TRIP_COMMANDS_DLQ_TOPIC=trip.commands.v1.dlq
CONSUMER_GROUP=trip-service
# --- ЛР5: устойчивость (обязательная часть) --------------------------------
PUSH_RETRY_MAX_ATTEMPTS=3
PUSH_BACKOFF_INITIAL=100ms
PUSH_BACKOFF_MAX=2s
PUSH_BACKOFF_MULTIPLIER=2.0
PUSH_BACKOFF_JITTER=0.2
PUSH_RATE_LIMIT_RPS=20
PUSH_RATE_LIMIT_BURST=40
# --- ЛР5: вариант A — transactional outbox ---------------------------------
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
# --- ЛР5: вариант B — in-memory cache --------------------------------------
CACHE_TTL=30s
CACHE_MAX_ENTRIES=10000
CACHE_SHARDS=16
# --- ЛР5: вариант C — websocket --------------------------------------------
WS_WRITE_TIMEOUT=5s
WS_PING_INTERVAL=15s
WS_CLIENT_BUFFER_SIZE=64
