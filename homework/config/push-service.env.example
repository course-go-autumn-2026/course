# ---------------------------------------------------------------------------
# Push Service — заглушка. Входит в состав локального окружения,
# студенты её не пишут, но настраивают, чтобы проверять устойчивость (ЛР5).
# ---------------------------------------------------------------------------

HTTP_ADDR=:8090
GRPC_ADDR=:9095
LOG_LEVEL=info

# Управляемые отказы: используются в ЛР5 для проверки backoff и rate limiter.
PUSH_FAIL_RATE=0.0        # доля ответов 503 / UNAVAILABLE, 0.0–1.0
PUSH_LATENCY_MS=0         # искусственная задержка ответа
PUSH_RATE_LIMIT_RPS=20    # выше лимита — 429 / RESOURCE_EXHAUSTED
PUSH_RATE_LIMIT_BURST=40
