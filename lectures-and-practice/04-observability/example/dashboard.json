{
  "id": null,
  "uid": "food-observability",
  "title": "Заказы: метрики, трейсы и логи",
  "description": "Локальный пример order-service → courier-service. Окно PromQL: 5 минут. Учебные цели не подтверждают месячный SLO.",
  "tags": ["course", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "links": [
    {"title": "Трейсы (Jaeger)", "type": "link", "url": "/explore?schemaVersion=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22jaeger%22%7D%7D", "targetBlank": true},
    {"title": "Логи (Loki)", "type": "link", "url": "/explore?schemaVersion=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22loki%22%7D%7D", "targetBlank": true}
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Завершённые заказы в секунду · окно 5 минут",
      "description": "Все результаты POST /orders. load.sh по умолчанию отправляет параллельные запросы с целевыми 5 RPS до остановки; фактический темп виден в его логах. Это не бенчмарк предельной производительности.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 9},
      "fieldConfig": {
        "defaults": {"unit": "ops", "min": 0, "custom": {"drawStyle": "line", "spanNulls": false}},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A", "editorMode": "code", "range": true,
          "expr": "sum(rate(orders_attempts_total{job=\"otel-collector\",exported_job=\"tripgo/order-service\"}[5m]))",
          "legendFormat": "Завершённые заказы"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Успешные заказы · окно 5 минут · цель 99,9%",
      "description": "Успешные / все завершённые попытки. При отсутствии трафика доля не определена. Только ошибки дают 0%. Линия показывает учебную цель за 5 минут.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 9},
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 99.9}]},
          "custom": {"drawStyle": "line", "spanNulls": false, "thresholdsStyle": {"mode": "line"}}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A", "editorMode": "code", "range": true,
          "expr": "100 * sum(rate(orders_attempts_total{job=\"otel-collector\",exported_job=\"tripgo/order-service\",outcome=\"success\"}[5m])) / (sum(rate(orders_attempts_total{job=\"otel-collector\",exported_job=\"tripgo/order-service\"}[5m])) > 0)",
          "legendFormat": "Успешность"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Длительность заказа p95 / p99 · окно 5 минут",
      "description": "Оценка по классической гистограмме в секундах, включая ошибки. Быстрый отказ может снизить перцентиль. Порог 0,8 с относится к отдельному SLI быстрого успеха.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 9, "w": 12, "h": 9},
      "fieldConfig": {
        "defaults": {
          "unit": "s", "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}]},
          "custom": {"drawStyle": "line", "spanNulls": false, "thresholdsStyle": {"mode": "line"}}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A", "editorMode": "code", "range": true,
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orders_duration_seconds_bucket{job=\"otel-collector\",exported_job=\"tripgo/order-service\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B", "editorMode": "code", "range": true,
          "expr": "histogram_quantile(0.99, sum by (le) (rate(orders_duration_seconds_bucket{job=\"otel-collector\",exported_job=\"tripgo/order-service\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Успешные заказы ≤ 800 мс · окно 5 минут · цель 99%",
      "description": "Успешные попытки не дольше 0,8 с / все попытки. Ошибки и медленные успехи ухудшают показатель. Нет трафика — нет значения; отсутствие успешных наблюдений при наличии ошибок даёт 0%.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 9, "w": 12, "h": 9},
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 99}]},
          "custom": {"drawStyle": "line", "spanNulls": false, "thresholdsStyle": {"mode": "line"}}
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A", "editorMode": "code", "range": true,
          "expr": "100 * (sum(rate(orders_duration_seconds_bucket{job=\"otel-collector\",exported_job=\"tripgo/order-service\",outcome=\"success\",le=\"0.8\"}[5m])) or (0 * sum(rate(orders_duration_seconds_count{job=\"otel-collector\",exported_job=\"tripgo/order-service\"}[5m])))) / (sum(rate(orders_duration_seconds_count{job=\"otel-collector\",exported_job=\"tripgo/order-service\"}[5m])) > 0)",
          "legendFormat": "Быстрый успех"
        }
      ]
    }
  ]
}
